# Telegram Admin Bot Token (from @BotFather)
BOT_TOKEN=7123456789:AAE...

# Telegram API credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# User Telegram Phone Number
PHONE_NUMBER=+998901234567

# Optional: Admin Telegram ID (for bot access control & log notifications)
OWNER_ID=123456789

# Delays configuration (in milliseconds)
GROUP_DELAY_MIN_MS=50000     # Kamida 50 soniya
GROUP_DELAY_MAX_MS=70000     # 70 soniyagacha
BATCH_PAUSE_GROUPS_COUNT=5   # Har 5 ta guruhdan so'ng dam olish
BATCH_PAUSE_MIN_MS=180000    # 3 daqiqa (180,000 ms)
BATCH_PAUSE_MAX_MS=240000    # 4 daqiqa (240,000 ms)
BATCH_PAUSE_MS=210000        # 3.5 daqiqa
CYCLE_DELAY_MIN_MS=900000    # 15 daqiqa (15 * 60 * 1000)
CYCLE_DELAY_MAX_MS=1200000   # 20 daqiqa (20 * 60 * 1000)
MAX_BATCH_GROUPS=15          # Faqat 15 tanlangan guruh
MAX_SENT_COUNT=5             # Umumiy 5 ta sikl
